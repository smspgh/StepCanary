{
  "name": "stepcanary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:db": "node scripts/dev-db.mjs",
    "dev": "wrangler dev -c wrangler.app.jsonc -c wrangler.ingest.jsonc --test-scheduled",
    "migrate": "node scripts/migrate.mjs",
    "gen:secret": "node scripts/gen-secret.mjs",
    "build:check": "wrangler deploy -c wrangler.ingest.jsonc --dry-run --outdir .build/ingest && wrangler deploy -c wrangler.app.jsonc --dry-run --outdir .build/app",
    "deploy:ingest": "wrangler deploy -c wrangler.ingest.jsonc",
    "deploy:app": "wrangler deploy -c wrangler.app.jsonc",
    "build:guides": "node scripts/build-guides.mjs"
  },
  "dependencies": {
    "croner": "^11.0.0",
    "hono": "^4.13.17",
    "luxon": "^3.7.2",
    "postgres": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
